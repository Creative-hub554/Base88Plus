{
  "name": "anybase",
  "version": "0.10.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev": "next dev",
    "preview": "node scripts/preview.js",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "check:node": "node scripts/check-node-contract.js",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:schedule-age": "node scripts/check-snapshot-age.js",
    "check:deploy-key": "node scripts/check-deploy-key.js",
    "check:oct3": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/oct3-check.ps1",
    "check:oct28": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/oct28-check.ps1",
    "check:oct4": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/oct4-sentinel.ps1",
    "check:oct29": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/oct29-sentinel.ps1",
    "update:schedule": "node scripts/update-schedule.js",
    "rotate": "node scripts/rotate.mjs",
    "verify:app": "node scripts/verify-generated-app.js",
    "verify:generated": "node scripts/verify-generated-app.js --all",
    "audit:demos": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/demo-link-audit.mjs",
    "check:perf": "vitest run --config vitest.perf.config.ts",
    "new:pin": "node scripts/new-generated-pin.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.53",
    "@ai-sdk/react": "^4.0.114",
    "ai": "^7.0.107",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.9",
    "@babel/plugin-syntax-jsx": "^7.29.7",
    "@babel/plugin-syntax-typescript": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "blakejs": "^1.2.1",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semver": "^7.7.2",
    "tailwindcss": "^4.3.3",
    "tweetnacl": "^1.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "yaml": "^2.8.0"
  }
}
